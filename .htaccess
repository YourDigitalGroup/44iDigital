# Fourge — force HTTPS site-wide.
# Passwords are hashed AT REST (Argon2id/bcrypt), but a login, password change,
# or API key sent over plain HTTP is exposed in transit. This redirect closes
# that gap so every request — public pages, the admin login, and api.php — is
# served over TLS.
#
# The second condition handles shared hosts and load balancers that terminate
# TLS at the edge and forward plain HTTP to PHP: there %{HTTPS} reads "off" even
# though the visitor is on HTTPS, so we also trust X-Forwarded-Proto. Without it
# you can hit an infinite redirect loop on those hosts.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} off
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>

# HSTS — tells browsers "only ever load this site over HTTPS." Left OFF by
# default ON PURPOSE: once a browser sees this header it will REFUSE http:// for
# max-age seconds, so a broken or expired certificate can make the whole site
# unreachable. Enable it ONLY after HTTPS is confirmed stable across the domain
# (and every subdomain, if you add includeSubDomains), by uncommenting:
# <IfModule mod_headers.c>
#   Header always set Strict-Transport-Security "max-age=31536000"
# </IfModule>

# Redirect the old CMS "Posts" system (data/posts.json + posts.html, never
# linked from the site nav) to the real, actively-linked /blog section — so
# any old bookmarks/links to /posts land somewhere real instead of a page
# nobody maintains. Query strings (posts.html?p=<slug>) are dropped since
# /blog doesn't use that parameter — the trailing "?" clears it.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{REQUEST_URI} !^/(admin|data)/ [NC]
  RewriteRule ^posts/?$ /blog? [R=301,L,NC]
</IfModule>

# Post-deploy audit (Sept 2026) — legacy WordPress URLs, Section 3 map.
# These are Google-indexed URLs from the old site; without these rules they
# 404 on www. One hop each, no chains.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^media-publishers/?$ https://www.44idigital.com/who-we-serve/publishers/ [R=301,L,NC]
  RewriteRule ^why-choose-us/?$ https://www.44idigital.com/why-44i [R=301,L,NC]
  RewriteRule ^markets/?$ https://www.44idigital.com/stories/ [R=301,L,NC]
  RewriteRule ^(television-radio|broadcast)/?$ https://www.44idigital.com/who-we-serve/tv-radio/ [R=301,L,NC]
  RewriteRule ^(advertising-agencies|traditional-agencies)/?$ https://www.44idigital.com/who-we-serve/agencies/ [R=301,L,NC]
  RewriteRule ^(contact|contact-us|free-demo)/?$ https://www.44idigital.com/book-a-demo [R=301,L,NC]
  RewriteRule ^(about|about-us|our-team)/?$ https://www.44idigital.com/why-44i [R=301,L,NC]
  # Option B cutover (Sept 2026) — flat URLs moved into the hub-and-spoke tree.
  # These run before the clean-URL block, so stale flat .html files left on the
  # server by earlier (non-deleting) deploys can never serve at the old URLs.
  RewriteRule ^tv\-radio(\.html)?/?$ https://www.44idigital.com/who-we-serve/tv-radio/ [R=301,L,NC]
  RewriteRule ^agencies(\.html)?/?$ https://www.44idigital.com/who-we-serve/agencies/ [R=301,L,NC]
  RewriteRule ^publishers(\.html)?/?$ https://www.44idigital.com/who-we-serve/publishers/ [R=301,L,NC]
  RewriteRule ^ooh(\.html)?/?$ https://www.44idigital.com/who-we-serve/ooh/ [R=301,L,NC]
  RewriteRule ^success\-stories(\.html)?/?$ https://www.44idigital.com/stories/ [R=301,L,NC]
  RewriteRule ^fourge\-insights(\.html)?/?$ https://www.44idigital.com/program/fourge-insights/ [R=301,L,NC]
  RewriteRule ^digital\-certification(\.html)?/?$ https://www.44idigital.com/program/digital-certification/ [R=301,L,NC]
  RewriteRule ^who-we-serve\.html$ https://www.44idigital.com/who-we-serve/ [R=301,L,NC]
  RewriteRule ^services\.html$ https://www.44idigital.com/services/ [R=301,L,NC]
  RewriteRule ^services/streaming\-tv\-ctv(\.html)?/?$ https://www.44idigital.com/services/targeted-digital/streaming-tv/ [R=301,L,NC]
  RewriteRule ^service-streaming\-tv\-ctv(\.html)?/?$ https://www.44idigital.com/services/targeted-digital/streaming-tv/ [R=301,L,NC]
  RewriteRule ^services/geofencing\-location\-targeting(\.html)?/?$ https://www.44idigital.com/services/targeted-digital/location-targeting/ [R=301,L,NC]
  RewriteRule ^service-geofencing\-location\-targeting(\.html)?/?$ https://www.44idigital.com/services/targeted-digital/location-targeting/ [R=301,L,NC]
  RewriteRule ^services/seo\-aeo(\.html)?/?$ https://www.44idigital.com/services/online-visibility/seo-aeo/ [R=301,L,NC]
  RewriteRule ^service-seo\-aeo(\.html)?/?$ https://www.44idigital.com/services/online-visibility/seo-aeo/ [R=301,L,NC]
  RewriteRule ^services/paid\-search(\.html)?/?$ https://www.44idigital.com/services/targeted-digital/search-engine-marketing/ [R=301,L,NC]
  RewriteRule ^service-paid\-search(\.html)?/?$ https://www.44idigital.com/services/targeted-digital/search-engine-marketing/ [R=301,L,NC]
  RewriteRule ^services/paid\-social(\.html)?/?$ https://www.44idigital.com/services/targeted-digital/paid-social/ [R=301,L,NC]
  RewriteRule ^service-paid\-social(\.html)?/?$ https://www.44idigital.com/services/targeted-digital/paid-social/ [R=301,L,NC]
  RewriteRule ^services/programmatic\-display(\.html)?/?$ https://www.44idigital.com/services/targeted-digital/targeted-display/ [R=301,L,NC]
  RewriteRule ^service-programmatic\-display(\.html)?/?$ https://www.44idigital.com/services/targeted-digital/targeted-display/ [R=301,L,NC]
  RewriteRule ^services/onsite\-lead\-gen(\.html)?/?$ https://www.44idigital.com/services/online-visibility/onsite-lead-gen/ [R=301,L,NC]
  RewriteRule ^service-onsite\-lead\-gen(\.html)?/?$ https://www.44idigital.com/services/online-visibility/onsite-lead-gen/ [R=301,L,NC]
  RewriteRule ^services/reputation\-management(\.html)?/?$ https://www.44idigital.com/services/content-marketing/reputation-management/ [R=301,L,NC]
  RewriteRule ^service-reputation\-management(\.html)?/?$ https://www.44idigital.com/services/content-marketing/reputation-management/ [R=301,L,NC]
  RewriteRule ^services/website\-development(\.html)?/?$ https://www.44idigital.com/services/online-visibility/website/ [R=301,L,NC]
  RewriteRule ^service-website\-development(\.html)?/?$ https://www.44idigital.com/services/online-visibility/website/ [R=301,L,NC]
  RewriteRule ^services/digital\-out\-of\-home(\.html)?/?$ https://www.44idigital.com/services/targeted-digital/digital-out-of-home/ [R=301,L,NC]
  RewriteRule ^service-digital\-out\-of\-home(\.html)?/?$ https://www.44idigital.com/services/targeted-digital/digital-out-of-home/ [R=301,L,NC]
  RewriteRule ^posts(\.html)?/?$ https://www.44idigital.com/blog [R=301,L,NC]
  RewriteRule ^what-we-offer/?$ https://www.44idigital.com/services/ [R=301,L,NC]
  RewriteRule ^demo/?$ https://www.44idigital.com/book-a-demo [R=301,L,NC]
  # From the GSC "Not found (404)" drilldown (Sept 2026) — old WordPress URLs
  RewriteRule ^tv-radio-broadcasters/?$ https://www.44idigital.com/who-we-serve/tv-radio/ [R=301,L,NC]
  RewriteRule ^white-label-demo/?$ https://www.44idigital.com/book-a-demo [R=301,L,NC]
  RewriteRule ^webinars/?$ https://www.44idigital.com/program/digital-certification/ [R=301,L,NC]
  # WP date archives (/2025/03/10/, /2024/11/) and taxonomy archives -> the blog
  RewriteRule ^[0-9]{4}/[0-9]{2}(/[0-9]{2})?/?$ https://www.44idigital.com/blog [R=301,L]
  RewriteRule ^(category|tag|author)/. https://www.44idigital.com/blog [R=301,L,NC]
  # Old WP service child pages -> the matching new tactic page
  RewriteRule ^services/seo/?$ https://www.44idigital.com/services/online-visibility/seo-aeo/ [R=301,L,NC]
  RewriteRule ^services/social-media/?$ https://www.44idigital.com/services/targeted-digital/paid-social/ [R=301,L,NC]
  RewriteRule ^services/websites?/?$ https://www.44idigital.com/services/online-visibility/website/ [R=301,L,NC]
  RewriteRule ^services/targeted-display/?$ https://www.44idigital.com/services/targeted-digital/targeted-display/ [R=301,L,NC]
  # Old WP blog slugs: send to the matching new post when one exists, else /blog
  RewriteCond %{DOCUMENT_ROOT}/blog-$1.html -f
  RewriteRule ^blog/([a-z0-9-]+)/?$ https://www.44idigital.com/blog-$1 [R=301,L]
  RewriteRule ^blog/.+$ https://www.44idigital.com/blog [R=301,L]
  # WordPress machinery is gone
  RewriteRule ^(feed|xmlrpc\.php|wp-login\.php)/?$ - [G,L,NC]
  RewriteRule ^wp-json(/.*)?$ - [G,L,NC]
</IfModule>

# Rev 5.1 — canonical host. Pages canonicalize to www; serve one hostname so
# search engines and AI crawlers see a single URL per page (deck item C3).
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTP_HOST} ^44idigital\.com$ [NC]
  RewriteRule ^ https://www.44idigital.com%{REQUEST_URI} [L,R=301]
</IfModule>


# Post-deploy audit — one URL per page: strip trailing slashes on non-directories
# (the legacy WP URLs used them; every new URL is extensionless with no slash).
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{REQUEST_URI} !^/(admin|data)/ [NC]
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^(.+)/$ /$1 [R=301,L]
</IfModule>

# Option B — /services/<x> that is neither a tier directory nor a mapped legacy
# slug falls back to the services hub instead of 404ing.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{DOCUMENT_ROOT}/services/$1 !-d
  RewriteRule ^services/([^/]+)/?$ https://www.44idigital.com/services/ [R=301,L]
</IfModule>

# Fourge — clean URLs.
# Serve /page from /page.html and drop the .html from the public URL so each
# page has one canonical, extensionless address (better for SEO). Files stay
# plain .html on disk; only the URL changes. The CMS, its data folder, and any
# real files/directories are left untouched, and this block is independent of
# the password-gate block api.php manages, so the two don't interfere.
<IfModule mod_rewrite.c>
  RewriteEngine On
  # /index.html → the site root (one canonical home URL).
  RewriteCond %{REQUEST_URI} !^/(admin|data)/ [NC]
  RewriteCond %{THE_REQUEST} \s/+index\.html?[\s?] [NC]
  RewriteRule ^ / [R=301,L]
  # Any explicit .html request → its extensionless URL (301).
  RewriteCond %{REQUEST_URI} !^/(admin|data)/ [NC]
  RewriteCond %{THE_REQUEST} \s/+(.+?)\.html[\s?] [NC]
  RewriteRule ^ /%1 [R=301,L]
  # Extensionless request → serve the matching .html file when it exists.
  RewriteCond %{REQUEST_URI} !^/(admin|data)/ [NC]
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME}\.html -f
  RewriteRule ^(.+?)/?$ $1.html [L]
</IfModule>

# BEGIN Fourge Protected Pages
<IfModule mod_rewrite.c>
RewriteEngine On
RewriteRule ^onboarding\.html$ /_fourge_gate.php?p=onboarding.html [L,QSA]
</IfModule>
# END Fourge Protected Pages
