# The admin app must always be fetched fresh: on Sept 11 a stale cached copy of
# an old template admin build republished live pages from outdated data. no-store
# forces every visit to load the current deployed admin.
<IfModule mod_headers.c>
  <FilesMatch "\.(html)$">
    Header set Cache-Control "no-store, max-age=0"
  </FilesMatch>
</IfModule>
